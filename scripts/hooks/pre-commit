#!/usr/bin/env bash
# Fast pre-commit checks (seconds): Python lint/format + TypeScript
# type-checks. The full gate (tests, builds, deploy build) runs on
# pre-push. Installed per clone via `./Quickstart hooks install`
# (core.hooksPath=scripts/hooks); bypass once with `git commit --no-verify`.
set -euo pipefail

if [ "${SPECODEX_SKIP_HOOKS:-}" = "1" ]; then
  exit 0
fi

ROOT="$(git rev-parse --show-toplevel)"
cd "$ROOT"

echo "==> pre-commit: ruff check"
uv run ruff check
echo "==> pre-commit: ruff format --check"
uv run ruff format --check

if [ -d app/node_modules ]; then
  echo "==> pre-commit: tsc --noEmit (backend)"
  (cd app/backend && npx tsc --noEmit -p .)
  echo "==> pre-commit: tsc --noEmit (frontend)"
  (cd app/frontend && npx tsc --noEmit -p .)
else
  echo "==> pre-commit: app/node_modules missing — skipping tsc (run: cd app && npm ci)"
fi
